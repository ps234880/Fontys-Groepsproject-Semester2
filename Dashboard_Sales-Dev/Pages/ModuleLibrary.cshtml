@page
@model Dashboard_Sales_Dev.Pages.ModuleLibraryModel
@using System.Globalization
@{
    ViewData["Title"] = "Module library";
    ViewData["Role"] = "Development";
    ViewData["Nav"] = "Module library";
    Layout = "_AppLayout";
}
@section Crumb {<span class="cur">Reference</span><span class="sep">/</span><span class="cur">Module library</span>}

<div class="ph"><div class="r1"><div><h1>Module library</h1><div class="sub">What sales can promise without building anything new.</div></div><div style="display:flex;gap:8px"><a class="btn" asp-page="/Module/Create"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14"/></svg> Add module<span class="go"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg></span></a></div></div></div>
<nav class="tabs"><a class="on" asp-page="/ModuleLibrary">All modules</a></nav>

<div class="content pad">
  @if (Model.ErrorMessage != null)
  {
    <div class="banner stop" role="alert">@Model.ErrorMessage</div>
  }

  @if (Model.Modules.Count == 0)
  {
    <div class="card"><div class="b"><p class="sm dim">There are no modules yet. Use "Add module" to add the first one.</p></div></div>
  }
  else
  {
    <div class="tw"><table class="tbl">
      <thead><tr>
        <th>Module</th>
        <th class="r" style="width:130px">Price</th>
        <th class="c" style="width:130px">Production time</th>
        <th style="width:130px">Created</th>
        <th class="r" style="width:150px"></th>
      </tr></thead>
      <tbody>
      @foreach (var module in Model.Modules)
      {
        <tr>
          <td><span class="t">@module.Name</span><div class="s">@module.Description</div></td>
          <td class="r num nowrap">€ @((module.PriceInCents / 100m).ToString("N2", CultureInfo.InvariantCulture))</td>
          <td class="c num nowrap">@module.ProductionTimeInWeeks @(module.ProductionTimeInWeeks == 1 ? "week" : "weeks")</td>
          <td class="nowrap dim">@module.CreatedAt.ToString("d MMM yyyy", CultureInfo.InvariantCulture)</td>
          <td class="r nowrap">
            <a class="lnk sm" asp-page="/Module/Edit" asp-route-id="@module.Id">Edit</a>
            &nbsp;
            <form method="post" asp-page-handler="Delete" asp-route-id="@module.Id" class="inline-form"
                  onsubmit="return confirm('Are you sure you want to delete this module?');">
              <button type="submit" class="lnk-stop sm">Delete</button>
            </form>
          </td>
        </tr>
      }
      </tbody></table>
      <div class="tfoot"><span>@Model.Modules.Count of @Model.Modules.Count modules</span></div></div>
  }
</div>
