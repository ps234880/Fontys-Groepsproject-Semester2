@page
@model IndexModel
@{
    ViewData["Title"] = "Sign in";
    Layout = "_BareLayout";
}

<div class="auth">
  <div class="auth-art">
    <div style="display:flex;align-items:center;gap:10px"><partial name="_CfgLogo" />
      <span style="font-weight:700;font-size:15px">Code for Good</span></div>
    <div style="flex:1"></div>
    <h1>Sales-to-Dev<br>Requirement Alignment</h1>
    <p style="margin-top:18px;max-width:44ch;font-size:15px;color:rgba(255,255,255,.9)">
      Development follows the sales pipeline, so reuse becomes visible and the scope
      can be adjusted before the contract is signed.</p>
    <div style="flex:1"></div>
    <p style="font-size:12.5px;color:rgba(255,255,255,.8)">Code for Good B.V. · Eindhoven &amp; Groningen</p>
  </div>

  <div class="auth-side"><div class="in-col">
    <h1>Sign in</h1>
    <p class="sm dim" style="margin-top:4px">Use your Code for Good account.</p>

    <div style="margin-top:26px">
      <div class="fld"><label>Email address</label><input class="in" type="email" placeholder="name@@wecfg.com"></div>
      <div class="fld"><label>Password</label><input class="in" type="password" placeholder="••••••••"></div>
      <div class="fld" style="display:flex;align-items:center;justify-content:space-between">
        <label class="chk on"><span class="b"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg></span>Stay signed in</label>
        <a class="sm" style="color:var(--accent-text);font-weight:600">Forgot password?</a></div>
      <a class="btn lg full" asp-page="/Sales/Index">Sign in<span class="go"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg></span></a>
      <a class="btn n lg full" style="margin-top:8px" asp-page="/Development/Index">Sign in with Microsoft 365</a>
    </div>

    <div style="margin-top:28px;padding-top:16px;border-top:1px solid var(--line)">
      <p class="xs dimmer">Demo environment. Choose a role:
        <a asp-page="/Sales/Index" style="color:var(--accent-text);font-weight:600">Sales</a> ·
        <a asp-page="/Development/Index" style="color:var(--accent-text);font-weight:600">Development</a></p>
    </div>
  </div></div>
</div>
