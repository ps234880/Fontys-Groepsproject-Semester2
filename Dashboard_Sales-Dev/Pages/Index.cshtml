@page
@model IndexModel
@{
    ViewData["Title"] = "Sign in";
    Layout = "_BareLayout";
}

<div class="auth">
  <div class="auth-art">
    <div style="display:flex;align-items:center;gap:10px"><partial name="_CfgLogo" />
      <span style="font-weight:700;font-size:15px">Code for Good</span></div>
    <div style="flex:1"></div>
    <h1>Sales-to-Dev<br>Requirement Alignment</h1>
    <p style="margin-top:18px;max-width:44ch;font-size:15px;color:rgba(255,255,255,.9)">
      Development follows the sales pipeline, so reuse becomes visible and the scope
      can be adjusted before the contract is signed.</p>
    <div style="flex:1"></div>
    <p style="font-size:12.5px;color:rgba(255,255,255,.8)">Code for Good B.V. · Eindhoven &amp; Groningen</p>
  </div>

  <div class="auth-side"><div class="in-col">
    <h1>Sign in</h1>
    <p class="sm dim" style="margin-top:4px">Use your Code for Good account.</p>

    <form method="post" style="margin-top:26px">
      @if (Model.Error != null)
      {
        <div class="banner stop" role="alert">@Model.Error</div>
      }
      <input type="hidden" asp-for="ReturnUrl" />
      <div class="fld"><label asp-for="Email">Email address</label><input asp-for="Email" class="in" type="email" autocomplete="username" required autofocus></div>
      <div class="fld"><label asp-for="Password">Password</label><input asp-for="Password" class="in" type="password" autocomplete="current-password" required></div>
      <div class="fld"><label class="sm" style="display:inline-flex;align-items:center;gap:8px;cursor:pointer"><input asp-for="RememberMe" type="checkbox" style="accent-color:var(--accent)"> Stay signed in</label></div>
      <button type="submit" class="btn lg full">Sign in<span class="go"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg></span></button>
    </form>
  </div></div>
</div>
