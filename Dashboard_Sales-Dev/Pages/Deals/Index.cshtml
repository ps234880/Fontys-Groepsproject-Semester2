@page
@model Dashboard_Sales_Dev.Pages.Deals.IndexModel
@using System.Globalization
@{
    ViewData["Title"] = "Deals";
    ViewData["Role"] = "Sales";
    ViewData["Nav"] = "Deals";
    Layout = "_AppLayout";
}
@section Crumb {<span class="cur">Sales</span><span class="sep">/</span><span class="cur">Deals</span>}

<div class="ph"><div class="r1"><div><h1>Deals</h1><div class="sub">@Model.Deals.Count @(Model.Deals.Count == 1 ? "deal" : "deals")</div></div><div style="display:flex;gap:8px"><a class="btn" asp-page="/Deals/New"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14"/></svg> New deal<span class="go"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg></span></a></div></div></div>
<nav class="tabs"><a class="on" asp-page="/Deals/Index">All deals</a></nav>

<div class="content pad">
  @if (Model.Deals.Count == 0)
  {
    <div class="card"><div class="b"><p class="sm dim">There are no deals yet. Use "New deal" to add the first one.</p></div></div>
  }
  else
  {
    <div class="tw"><table class="tbl">
      <thead><tr>
        <th>Customer / project</th>
        <th style="width:180px">Contact person</th>
        <th style="width:130px">Estimated date</th>
        <th style="width:160px">Owner</th>
        <th style="width:130px">Created</th>
      </tr></thead>
      <tbody>
      @foreach (var deal in Model.Deals)
      {
        <tr>
          <td><a class="lnk" asp-page="/Deals/Detail" asp-route-id="@deal.Id">@deal.ClientCompanyName</a><div class="s">@deal.Title</div></td>
          <td class="dim nowrap">@deal.ClientName</td>
          <td class="nowrap dim">@deal.EstimatedDate.ToString("d MMM yyyy", CultureInfo.InvariantCulture)</td>
          <td class="dim nowrap">@deal.EmployeeName</td>
          <td class="nowrap dim">@deal.CreatedAt.ToString("d MMM yyyy", CultureInfo.InvariantCulture)</td>
        </tr>
      }
      </tbody></table>
      <div class="tfoot"><span>@Model.Deals.Count of @Model.Deals.Count deals</span></div></div>
  }
</div>
