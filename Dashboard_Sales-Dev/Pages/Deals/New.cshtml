@page
@model Dashboard_Sales_Dev.Pages.Deals.NewModel
@{
    ViewData["Title"] = "New deal";
    ViewData["Role"] = "Sales";
    ViewData["Nav"] = "Deals";
    Layout = "_AppLayout";
}
@section Crumb {<span class="cur">Sales</span><span class="sep">/</span><a asp-page="/Deals/Index">Deals</a><span class="sep">/</span><span class="cur">New deal</span>}

<form method="post">
<div class="ph"><div class="r1"><div><h1>New deal</h1><div class="sub">Record the deal as soon as negotiation starts, so development can follow along.</div></div><div style="display:flex;gap:8px"><a class="btn n" asp-page="/Deals/Index">Cancel</a><button type="submit" class="btn">Save deal<span class="go"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg></span></button></div></div></div>

<div class="content pad"><div style="max-width:760px">
  <div class="card"><div class="h"><h2>Customer</h2></div><div class="b">
    <div class="fields" style="max-width:none">
      <div class="fld"><label asp-for="Input.CompanyName">Company name <span class="req">*</span></label>
        <input asp-for="Input.CompanyName" class="in" placeholder="e.g. Gemeente Tilburg" required />
        <span asp-validation-for="Input.CompanyName" class="field-error"></span></div>
      <div class="cols">
        <div class="fld"><label asp-for="Input.FirstName">First name <span class="req">*</span></label>
          <input asp-for="Input.FirstName" class="in" required />
          <span asp-validation-for="Input.FirstName" class="field-error"></span></div>
        <div class="fld"><label asp-for="Input.LastName">Last name <span class="req">*</span></label>
          <input asp-for="Input.LastName" class="in" required />
          <span asp-validation-for="Input.LastName" class="field-error"></span></div>
        <div class="fld"><label asp-for="Input.Email">Email address <span class="req">*</span></label>
          <input asp-for="Input.Email" type="email" class="in" placeholder="name@@customer.nl" required />
          <span asp-validation-for="Input.Email" class="field-error"></span></div>
        <div class="fld"><label asp-for="Input.PhoneNumber">Phone number <span class="req">*</span></label>
          <input asp-for="Input.PhoneNumber" class="in" required />
          <span asp-validation-for="Input.PhoneNumber" class="field-error"></span></div>
      </div>
      <div class="help">This is the contact person of the customer. More contact persons per company are not supported yet.</div>
    </div></div></div>

  <div class="card"><div class="h"><h2>Deal</h2></div><div class="b">
    <div class="fields" style="max-width:none">
      <div class="fld"><label asp-for="Input.Title">Project name <span class="req">*</span></label>
        <input asp-for="Input.Title" class="in" placeholder="e.g. Citizen Portal 2027" required />
        <span asp-validation-for="Input.Title" class="field-error"></span></div>
      <div class="fld"><label asp-for="Input.Description">Description <span class="req">*</span></label>
        <textarea asp-for="Input.Description" class="ta" placeholder="What does the customer want, and why?" required></textarea>
        <span asp-validation-for="Input.Description" class="field-error"></span></div>
      <div class="fld" style="margin-bottom:0"><label asp-for="Input.EstimatedDate">Estimated date <span class="req">*</span></label>
        <input asp-for="Input.EstimatedDate" type="date" class="in" required />
        <span asp-validation-for="Input.EstimatedDate" class="field-error"></span></div>
    </div></div></div>

  <div class="f" style="display:flex;justify-content:flex-end;gap:8px">
    <a class="btn n" asp-page="/Deals/Index">Cancel</a>
    <button type="submit" class="btn">Save deal<span class="go"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg></span></button>
  </div>
</div></div>
</form>
