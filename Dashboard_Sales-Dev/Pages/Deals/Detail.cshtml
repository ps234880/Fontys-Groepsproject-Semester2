@page "{id:int}"
@model Dashboard_Sales_Dev.Pages.Deals.DetailModel
@using System.Globalization
@{
    ViewData["Title"] = Model.Deal.ClientCompanyName;
    ViewData["Role"] = "Sales";
    ViewData["Nav"] = "Deals";
    Layout = "_AppLayout";
}
@section Crumb {<span class="cur">Sales</span><span class="sep">/</span><a asp-page="/Deals/Index">Deals</a><span class="sep">/</span><span class="cur">@Model.Deal.ClientCompanyName</span>}

<div class="ph"><div class="r1"><div><h1>@Model.Deal.ClientCompanyName</h1><div class="sub">@Model.Deal.Title</div></div><div style="display:flex;gap:8px"><a class="btn n" asp-page="/Deals/Index">Back to deals</a></div></div></div>

<div class="content pad"><div style="max-width:760px">
  <div class="card"><div class="h"><h2>Deal</h2></div><div class="b">
    <div class="fields" style="max-width:none">
      <div class="fld"><label>Project name</label><div>@Model.Deal.Title</div></div>
      <div class="fld"><label>Description</label><div style="white-space:pre-line">@Model.Deal.Description</div></div>
      <div class="cols">
        <div class="fld"><label>Estimated date</label><div>@Model.Deal.EstimatedDate.ToString("d MMMM yyyy", CultureInfo.InvariantCulture)</div></div>
        <div class="fld"><label>Owner</label><div>@Model.Deal.EmployeeName</div></div>
        <div class="fld" style="margin-bottom:0"><label>Created</label><div>@Model.Deal.CreatedAt.ToString("d MMMM yyyy HH:mm", CultureInfo.InvariantCulture)</div></div>
      </div>
    </div></div></div>

  <div class="card"><div class="h"><h2>Customer</h2></div><div class="b">
    <div class="fields" style="max-width:none">
      <div class="fld"><label>Company</label><div>@Model.Deal.ClientCompanyName</div></div>
      <div class="cols">
        <div class="fld" style="margin-bottom:0"><label>Contact person</label><div>@Model.Deal.ClientName</div></div>
        <div class="fld" style="margin-bottom:0"><label>Email address</label><div>@Model.Deal.ClientEmail</div></div>
        <div class="fld" style="margin-bottom:0"><label>Phone number</label><div>@Model.Deal.ClientPhoneNumber</div></div>
      </div>
    </div></div></div>
</div></div>
