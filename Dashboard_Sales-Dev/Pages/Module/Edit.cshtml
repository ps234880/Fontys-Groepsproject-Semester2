@page "{id:int}"
@model Dashboard_Sales_Dev.Pages.Module.EditModel
@{
    ViewData["Title"] = "Edit module";
    ViewData["Role"] = "Development";
    ViewData["Nav"] = "Module library";
    Layout = "_AppLayout";
}
@section Crumb {<span class="cur">Reference</span><span class="sep">/</span><a asp-page="/ModuleLibrary">Module library</a><span class="sep">/</span><span class="cur">Edit module</span>}

<form method="post">
<div class="ph"><div class="r1"><div><h1>Edit module</h1><div class="sub">@Model.Module.Name</div></div><div style="display:flex;gap:8px"><a class="btn n" asp-page="/ModuleLibrary">Cancel</a><button type="submit" class="btn">Save changes<span class="go"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg></span></button></div></div></div>

<div class="content pad"><div style="max-width:760px">
  <div class="card"><div class="h"><h2>Module</h2></div><div class="b">
    <div class="fields" style="max-width:none">
      <div class="fld"><label asp-for="Module.Name">Name <span class="req">*</span></label>
        <input asp-for="Module.Name" class="in" required />
        <span asp-validation-for="Module.Name" class="field-error"></span></div>
      <div class="fld"><label asp-for="Module.Description">Description <span class="req">*</span></label>
        <textarea asp-for="Module.Description" class="ta" required></textarea>
        <span asp-validation-for="Module.Description" class="field-error"></span></div>
      <div class="cols">
        <div class="fld" style="margin-bottom:0"><label asp-for="Module.PriceInCents">Price in cents <span class="req">*</span></label>
          <input asp-for="Module.PriceInCents" type="number" min="0" class="in" required />
          <span asp-validation-for="Module.PriceInCents" class="field-error"></span></div>
        <div class="fld" style="margin-bottom:0"><label asp-for="Module.ProductionTimeInWeeks">Production time in weeks <span class="req">*</span></label>
          <input asp-for="Module.ProductionTimeInWeeks" type="number" min="1" class="in" required />
          <span asp-validation-for="Module.ProductionTimeInWeeks" class="field-error"></span></div>
      </div>
    </div></div></div>
</div></div>
</form>
