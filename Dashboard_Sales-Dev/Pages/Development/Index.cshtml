@page
@model Dashboard_Sales_Dev.Pages.Development.IndexModel
@using System.Globalization
@using Dashboard_Sales_Dev.Logic.Models
@{
    ViewData["Title"] = "Overview";
    ViewData["Role"] = "Development";
    ViewData["Nav"] = "Overview";
    Layout = "_AppLayout";
}
@section Crumb {<span class="cur">Development</span><span class="sep">/</span><span class="cur">Overview</span>}

<div class="ph"><div class="r1"><div><h1>Overview</h1><div class="sub">@Model.Deals.Count open @(Model.Deals.Count == 1 ? "deal" : "deals"), @Model.DealsWithoutModules without modules yet.</div></div><div style="display:flex;gap:8px"><a class="btn n" asp-page="/ModuleLibrary">Module library</a></div></div></div>
<div class="content pad">
  <div class="card"><div class="h"><h2>Open deals</h2><a class="sm" style="color:var(--accent-text);font-weight:600" asp-page="/Deals/Index">Sales pipeline</a></div>
    @if (Model.Deals.Count == 0)
    {
      <div class="b"><p class="sm dim">There are no open deals.</p></div>
    }
    else
    {
      <div style="padding:0"><div class="tw"><table class="tbl">
        <thead><tr>
          <th>Customer / project</th>
          <th style="width:150px">Owner</th>
          <th style="width:110px">Stage</th>
          <th class="c" style="width:90px">Probability</th>
          <th class="c" style="width:80px">Modules</th>
          <th class="c" style="width:120px">Production time</th>
          <th style="width:120px">Estimated date</th>
          <th style="width:150px">Progress</th>
        </tr></thead>
        <tbody>
          @foreach (var item in Model.Deals)
          {
            <tr>
              <td><a class="lnk" asp-page="/Deals/Detail" asp-route-id="@item.Deal.Id">@item.Deal.ClientCompanyName</a><div class="s">@item.Deal.Title</div></td>
              <td class="dim">@item.Deal.EmployeeName</td>
              <td class="dim nowrap">@item.Deal.StatusName@if (item.Deal.WaitingOnRole != null) {<div class="s">Waiting for @item.Deal.WaitingOnRole</div>}</td>
              <td class="c num">@item.Deal.Probability%</td>
              <td class="c num">@item.ModuleCount</td>
              <td class="c num nowrap">@(item.ModuleCount == 0 ? "–" : item.ProductionTimeInWeeks + (item.ProductionTimeInWeeks == 1 ? " week" : " weeks"))</td>
              <td class="nowrap dim">@item.Deal.EstimatedDate.ToString("d MMM yyyy", CultureInfo.InvariantCulture)</td>
              <td>
                @switch (item.Progress)
                {
                  case DealProgress.NoModules:
                    <span class="tag stop">No modules yet</span>
                    break;
                  case DealProgress.DateTooEarly:
                    <span class="tag warn">Date too early</span>
                    break;
                  default:
                    <span class="tag ok">On track</span>
                    break;
                }
              </td>
            </tr>
          }
        </tbody>
      </table></div></div>
    }
  </div>

  <div class="card"><div class="h"><h2>Latest comments</h2></div>
    @if (Model.LatestComments.Count == 0)
    {
      <div class="b"><p class="sm dim">No comments yet.</p></div>
    }
    @foreach (var comment in Model.LatestComments)
    {
      <div class="msg"><span class="av">@comment.Initials</span><div class="bd">
        <div class="hd"><span class="w">@comment.EmployeeName</span><span class="tag @(comment.EmployeeRole == "Development" ? "info" : "idle")">@comment.EmployeeRole</span><span class="t">@comment.CreatedAt.ToString("d MMM yyyy HH:mm", CultureInfo.InvariantCulture)</span></div>
        <p>@comment.Message</p>
        <p style="margin-top:8px"><a class="sm" style="color:var(--accent-text);font-weight:600" asp-page="/Deals/Detail" asp-route-id="@comment.DealId">@comment.CompanyName · @comment.DealTitle</a></p>
      </div></div>
    }
  </div>
</div>
