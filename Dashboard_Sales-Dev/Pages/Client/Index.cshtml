@page
@model Dashboard_Sales_Dev.Pages.Client.Index
@using System.Globalization
@{
    ViewData["Title"] = "Customers";
    ViewData["Role"] = "Sales";
    ViewData["Nav"] = "Customers";
    Layout = "_AppLayout";
}
@section Crumb {<span class="cur">Sales</span><span class="sep">/</span><span class="cur">Customers</span>}

<div class="ph"><div class="r1"><div><h1>Customers</h1><div class="sub">@Model.Clients.Count @(Model.Clients.Count == 1 ? "customer" : "customers")</div></div></div></div>
<nav class="tabs"><a class="on" asp-page="/Client/Index">All customers</a></nav>

<div class="content pad">
  @if (Model.Clients.Count == 0)
  {
    <div class="card"><div class="b"><p class="sm dim">There are no customers yet. A customer is created together with a new deal.</p></div></div>
  }
  else
  {
    <div class="tw"><table class="tbl">
      <thead><tr>
        <th>Company</th>
        <th style="width:200px">Contact person</th>
        <th style="width:220px">Email</th>
        <th style="width:160px">Phone</th>
        <th style="width:130px">Created</th>
      </tr></thead>
      <tbody>
      @foreach (var client in Model.Clients)
      {
        <tr>
          <td>@client.CompanyName</td>
          <td class="dim nowrap">@client.FirstName @client.LastName</td>
          <td class="dim nowrap">@client.Email</td>
          <td class="dim nowrap">@client.PhoneNumber</td>
          <td class="nowrap dim">@client.CreatedAt.ToString("d MMM yyyy", CultureInfo.InvariantCulture)</td>
        </tr>
      }
      </tbody></table>
      <div class="tfoot"><span>@Model.Clients.Count of @Model.Clients.Count customers</span></div></div>
  }
</div>
