@page "{id:int}"
@model Dashboard_Sales_Dev.Pages.Client.EditModel
@{
    ViewData["Title"] = "Edit customer";
    ViewData["Role"] = "Sales";
    ViewData["Nav"] = "Customers";
    Layout = "_AppLayout";
}
@section Crumb {<span class="cur">Sales</span><span class="sep">/</span><a asp-page="/Client/Index">Customers</a><span class="sep">/</span><span class="cur">Edit customer</span>}

<form method="post">
<div class="ph"><div class="r1"><div><h1>Edit customer</h1><div class="sub">@Model.Client.CompanyName</div></div></div></div>

<div class="content pad"><div style="max-width:760px">
  @if (Model.ErrorMessage != null)
  {
    <p class="field-error" style="margin-bottom:16px">@Model.ErrorMessage</p>
  }
  <div class="card"><div class="h"><h2>Customer</h2></div><div class="b">
    <div class="fields" style="max-width:none">
      <div class="fld"><label asp-for="Client.CompanyName">Company <span class="req">*</span></label>
        <input asp-for="Client.CompanyName" class="in" required />
        <span asp-validation-for="Client.CompanyName" class="field-error"></span></div>
      <div class="cols">
        <div class="fld"><label asp-for="Client.FirstName">First name <span class="req">*</span></label>
          <input asp-for="Client.FirstName" class="in" required />
          <span asp-validation-for="Client.FirstName" class="field-error"></span></div>
        <div class="fld"><label asp-for="Client.LastName">Last name <span class="req">*</span></label>
          <input asp-for="Client.LastName" class="in" required />
          <span asp-validation-for="Client.LastName" class="field-error"></span></div>
      </div>
      <div class="cols">
        <div class="fld" style="margin-bottom:0"><label asp-for="Client.Email">Email <span class="req">*</span></label>
          <input asp-for="Client.Email" type="email" class="in" required />
          <span asp-validation-for="Client.Email" class="field-error"></span></div>
        <div class="fld" style="margin-bottom:0"><label asp-for="Client.PhoneNumber">Phone <span class="req">*</span></label>
          <input asp-for="Client.PhoneNumber" type="tel" class="in" required />
          <span asp-validation-for="Client.PhoneNumber" class="field-error"></span></div>
      </div>
    </div></div></div>

  <div style="display:flex;justify-content:space-between;align-items:center;margin-top:16px">
    <button type="submit" class="btn n" asp-page-handler="Delete" asp-route-id="@Model.Client.Id" formnovalidate
            style="background:#dc2626;border-color:#dc2626;color:#fff"
            onclick="return confirm('Are you sure you want to delete this customer? This cannot be undone.')">Delete</button>
    <div style="display:flex;gap:8px">
      <a class="btn n" asp-page="/Client/Index">Cancel</a>
      <button type="submit" class="btn">Save changes<span class="go"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg></span></button>
    </div>
  </div>
</div></div>
</form>