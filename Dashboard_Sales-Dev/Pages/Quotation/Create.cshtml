@page
@model Dashboard_Sales_Dev.Pages.Quotation.CreateModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Create";
}

<form method="post">
    <div>
        <div>Klant</div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="Client.CompanyName" class="form-label">Bedijfsnaam <span class="text-danger">*</span></label>
                    <input asp-for="Client.CompanyName" class="form-control bg-light text-dark border-secondary" required />
                    <span asp-validation-for="Client.CompanyName" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Client.PhoneNumber">Telefoonnummer</label>
                    <input asp-for="Client.PhoneNumber" class="form-control bg-light text-dark border-secondary" required />
                    <span asp-validation-for="Client.PhoneNumber" class="text-danger"></span>
                </div>
                
                <div class="col-md-6">
                    <label asp-for="Client.FirstName">Voornaam</label>
                    <input asp-for="Client.FirstName" class="form-control bg-light text-dark border-secondary" required />
                    <span asp-validation-for="Client.FirstName" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Client.LastName">Achternaam</label>
                    <input asp-for="Client.LastName" class="form-control bg-light text-dark border-secondary" required />
                    <span asp-validation-for="Client.LastName" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Client.Email">E-mailadres</label>
                    <input asp-for="Client.Email" class="form-control bg-light text-dark border-secondary" required />
                    <span asp-validation-for="Client.Email" class="text-danger"></span>
                </div>
            </div>
        </div>
        
        <div>Quotation </div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="Quotation.Title" class="form-label">Title <span class="text-danger">*</span></label>
                    <input asp-for="Quotation.Title" class="form-control bg-light text-dark border-secondary" required />
                    <span asp-validation-for="Quotation.Title" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Quotation.Description"></label>
                    <textarea asp-for="Quotation.Description" class="form-control"></textarea>
                    <span asp-validation-for="Quotation.Description" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Quotation.EstimatedDate">Estimated Date</label>
                    <input asp-for="Quotation.EstimatedDate" type="date" class="form-control bg-light text-dark border-secondary" required />
                    <span asp-validation-for="Quotation.EstimatedDate" class="text-danger"></span>
                </div>
            </div>
        </div>
    </div>
    
    <div class="d-flex justify-content-end gap-2">
        <a asp-page="./Index" class="btn btn-outline-secondary">Annuleren</a>
        <button type="submit" class="btn btn-primary px-4">Opslaan</button>
    </div>

</form>