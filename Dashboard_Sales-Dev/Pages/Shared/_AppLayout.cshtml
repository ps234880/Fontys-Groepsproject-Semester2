<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>@ViewData["Title"] · Sales-to-Dev</title>
<link rel="stylesheet" href="~/css/app.css" asp-append-version="true">
<script src="~/js/theme.js" asp-append-version="true"></script>
</head>
<body>
<div class="app"><partial name="@(User.IsInRole("Development") ? "_SidebarDev" : "_SidebarSales")" /><div class="main"><header class="top"><nav class="crumb">@RenderSection("Crumb", required: true)</nav><span class="sp"></span><form class="search" role="search" method="get" action="/Search"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.3-4.3"/></svg><input id="search-input" type="search" name="q" maxlength="100" placeholder="Search" aria-label="Search deals, customers and modules" value="@Context.Request.Query["q"]"><span class="kbd">&#8984;K</span></form><button type="button" class="theme-btn" data-theme-toggle aria-pressed="false" aria-label="Light mode" title="Light mode"><svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg><svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg></button></header>@RenderBody()</div></div>
<script>
document.addEventListener('keydown', function (event) {
  if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
    event.preventDefault();
    document.getElementById('search-input').focus();
  }
});
</script>
</body>
</html>
