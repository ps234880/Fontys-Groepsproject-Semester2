@using Dashboard_Sales_Dev.Authentication
@{
    var nav = ViewData["Nav"] as string;
}
<aside class="side">
      <div class="side-top"><partial name="_CfgLogo" /><span class="nm">Code for Good</span></div>
      <nav class="side-scroll"><div class="nav-g"><a class="nav-i@(nav == "Overview" ? " on" : "")" asp-page="/Sales/Index"><span>Overview</span></a><a class="nav-i@(nav == "Deals" ? " on" : "")" asp-page="/Deals/Index"><span>Deals</span></a><a class="nav-i@(nav == "Customers" ? " on" : "")" asp-page="/Client/Index"><span>Customers</span></a></div><div class="nav-g"><a class="nav-i@(nav == "Module library" ? " on" : "")" asp-page="/ModuleLibrary"><span>Module library</span></a></div></nav>
      <div class="side-foot"><div class="u"><span class="av b">@User.GetInitials()</span>
        <span><span class="n">@User.Identity?.Name</span><br><span class="r">@User.GetRole()</span></span></div>
        <form method="post" asp-page="/Logout" style="margin-top:10px"><button type="submit" class="lnk sm dim">Sign out</button></form></div>
    </aside>
